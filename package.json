{
  "name": "accessibility-auditor-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome Extension for automated WCAG 2.2 accessibility and OWASP security auditing",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "axe-core": "4.10.2",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wxt": "^0.19.28"
  }
}
